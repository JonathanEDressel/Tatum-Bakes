# MongoDB Connection
MONGO_URI="mongodb://localhost:27017/"

# Server Port
PORT=8080

# Postmark API Configuration
# Get your API key from: https://postmarkapp.com/
POSTMARK_API_KEY=your_postmark_server_api_key_here

# Email addresses for Postmark
# From: Must be a verified sender signature in your Postmark account
POSTMARK_FROM_EMAIL=noreply@yourdomain.com

# To: Email address where order inquiries will be sent
POSTMARK_TO_EMAIL=orders@yourdomain.com
